# ══════════════════════════════════════════════════════════════
# Restos Backend — Environment Variables
# Copy this file to .env and fill in your values.
# ══════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=5000

# ── Database (Supabase PostgreSQL) ───────────────────────────
# Get this from: Supabase dashboard → Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_to_a_long_random_string_32chars
JWT_REFRESH_SECRET=change_me_to_another_long_random_string

# ── Platform ─────────────────────────────────────────────────
PLATFORM_NAME=Restos
PLATFORM_DOMAIN=restos.com
PLATFORM_URL=https://your-backend.onrender.com
FRONTEND_URL=https://your-app.vercel.app
SUBDOMAIN_SUFFIX=.restos.com

# For local dev only (routes /site/:subdomain to the right restaurant)
# SITE_BASE_URL=http://localhost:5173/s

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# ── File Uploads ─────────────────────────────────────────────
UPLOAD_PATH=./uploads
MAX_FILE_SIZE_MB=10
# Base URL used to build image URLs returned to the frontend
STORAGE_BASE_URL=https://your-backend.onrender.com/uploads

# ── Email (optional) ─────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Restos Platform
SMTP_FROM_EMAIL=noreply@restos.com
